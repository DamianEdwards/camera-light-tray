<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CameraLightTray.App\Diagnostics\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\CameraLightTray.Core\CameraLightTray.Core.csproj" />
    <Compile Include="..\..\src\CameraLightTray.App\Platform\MonitorClient.cs" Link="MonitorClient.cs" />
    <Compile Include="..\..\src\CameraLightTray.App\Platform\SensorMonitorRecovery.cs" Link="SensorMonitorRecovery.cs" />
    <Compile Include="..\..\src\CameraLightTray.App\Platform\SensorActivityMonitor.cs" Link="SensorActivityMonitor.cs" />
    <Compile Include="..\..\src\CameraLightTray.Monitor\ProcessCatalog.cs" Link="ProcessCatalog.cs" />
    <Compile Include="..\..\src\CameraLightTray.App\Native\FlyoutPlacement.cs" Link="FlyoutPlacement.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>
</Project>
